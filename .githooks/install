#!/bin/sh
# Draait ook als `prepare` bij bun install. Zonder git-repo (image-build) niets doen.
set -eu
git rev-parse --git-dir >/dev/null 2>&1 || exit 0
cd "$(git rev-parse --show-toplevel)"

# Alleen de eerste twee getallen: `git version` plakt er van alles achter
# ("2.39.3 (Apple Git-145)"), en sort -V is geen POSIX.
v="$(git version | sed -n 's/^git version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')"
[ -n "$v" ] || exit 0
major="${v% *}"
minor="${v#* }"

# Nooit allebei tegelijk: na een git-upgrade zou anders elke hook dubbel draaien.
if [ "$major" -gt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -ge 54 ]; }; then
	git config --unset-all core.hooksPath 2>/dev/null || true
	git config include.path ../hooks.gitconfig
elif [ "$major" -eq 2 ] && [ "$minor" -ge 9 ]; then
	git config --unset-all include.path 2>/dev/null || true
	git config core.hooksPath .githooks
else
	echo "hooks: git $major.$minor heeft geen core.hooksPath (2.9+), overgeslagen" >&2
fi
