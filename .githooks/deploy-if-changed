#!/bin/sh
# Herdeployt alleen waar de container van dit project al draait, en alleen als
# er sinds de vorige deploy iets in de deploybare paden veranderde. Een machine
# die hem niet serveert deployt dus nooit, zonder dat daar iets voor ingesteld
# hoeft te worden.
set -eu
cd "$(git rev-parse --show-toplevel)"
command -v docker >/dev/null 2>&1 || exit 0
name="$(sed -n 's/^ *container_name: *//p' compose.yaml | head -1)"
[ -n "$name" ] || exit 0
# Geen daemon, geen rechten, geen container: alle drie hetzelfde antwoord.
docker ps --filter "name=^${name}$" --format '{{.Names}}' 2>/dev/null | grep -qx "$name" || exit 0

gitdir="$(git rev-parse --git-dir)"
marker="$gitdir/last-deploy"
paths="src server public scripts Dockerfile Makefile compose.yaml build.ts index.html package.json bun.lock tsconfig.json"

# shellcheck disable=SC2086
if [ -f "$marker" ] && git diff --quiet "$(cat "$marker")" HEAD -- $paths 2>/dev/null; then
	exit 0
fi

# In de achtergrond: een push of pull mag niet minuten op docker wachten.
# flock -n: loopt er al een deploy, dan vangt de volgende trigger dit op.
#
# De marker krijgt de commit die gebouwd IS, niet HEAD na afloop. Verschuift
# HEAD tijdens de build (een rebase doet dat), dan wijkt de marker daarna af en
# deployt de volgende trigger opnieuw, in plaats van een commit te claimen die
# nooit in de image zat.
built="$(git rev-parse HEAD)"
echo "deploy: gestart voor ${built%"${built#???????}"}, log in $gitdir/deploy.log"
nohup flock -n "$gitdir/deploy.lock" sh -c \
	"make live >> '$gitdir/deploy.log' 2>&1 && printf '%s\n' '$built' > '$marker'" \
	>/dev/null 2>&1 &
