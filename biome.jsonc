{
	"$schema": "./node_modules/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "master"
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!**/out", "!bun.lock"]
	},
	"formatter": { "enabled": false, "indentStyle": "tab" },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"correctness": {
				"useImportExtensions": "off",
				"useQwikValidLexicalScope": "off",
				"noUnresolvedImports": "off",
				"noNodejsModules": "off"
			},
			"complexity": {
				"useLiteralKeys": "off"
			},
			"style": {
				"noContinue": "off",
				"noIncrementDecrement": "off",
				"noTernary": "off",
				"useBlockStatements": "off",
				"useDestructuring": "off",
				"useNumericSeparators": "off"
			}
		},
		"domains": {
			"project": "recommended",
			"test": "recommended",
			"types": "recommended"
		}
	},
	"javascript": { "formatter": { "quoteStyle": "single" } },
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["*.config.ts"],
			"linter": { "rules": { "style": { "noDefaultExport": "off" } } }
		}
	]
}
