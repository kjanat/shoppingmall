{
	"$schema": "./node_modules/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "master"
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!**/out", "!bun.lock"]
	},
	"formatter": { "enabled": false, "indentStyle": "tab" },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"correctness": {
				"useImportExtensions": "off",
				"useQwikValidLexicalScope": "off",
				"noUnresolvedImports": "off",
				"noNodejsModules": "off",
				"noUndeclaredVariables": "off"
			},
			"complexity": {
				"noImplicitCoercions": "off",
				"useLiteralKeys": "off"
			},
			"style": {
				"noExcessiveLinesPerFile": {
					"level": "warn",
					"options": { "maxLines": 65535, "skipBlankLines": true }
				},
				"useConsistentTypeDefinitions": {
					"level": "warn",
					"fix": "safe"
				},
				"noContinue": "off",
				"noIncrementDecrement": "off",
				"noTernary": "off",
				"noNestedTernary": "off",
				"useBlockStatements": "off",
				"useDestructuring": "off",
				"useNumericSeparators": "off",
				"useGlobalThis": "error"
			},
			"suspicious": { "noConsole": "off" },
			"security": {
				"noSecrets": {
					"options": { "entropyThreshold": 80 },
					"level": "warn"
				}
			}
		},
		"domains": {
			"drizzle": "recommended",
			"project": "recommended",
			"test": "recommended",
			"types": "recommended"
		}
	},
	"javascript": { "formatter": { "quoteStyle": "single" } },
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["*.config.ts"],
			"linter": { "rules": { "style": { "noDefaultExport": "off" } } }
		},
		{
			"includes": ["server/db/client.ts"],
			"linter": { "rules": { "performance": { "noNamespaceImport": "off" } } }
		},
		{
			"includes": ["tests/**/*.test.ts"],
			"linter": {
				"rules": { "preset": "recommended" },
				"domains": { "test": "all" }
			}
		}
	]
}
