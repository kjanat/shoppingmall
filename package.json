{
	"name": "mall-sim",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "run -s typecheck build.ts",
		"build:static": "tsc && bun build.ts --static",
		"dev": "bun --hot server/main.ts",
		"fmt": "run lint --fix; dprint fmt .",
		"lint": "biome check",
		"prestart": "run build",
		"start": "NODE_ENV=production dist/mall",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@elevenlabs/elevenlabs-js": "^2.60",
		"@openrouter/sdk": "^1.2",
		"ansispeck": "^0.4",
		"gsap": "^3.15",
		"postprocessing": "^6.39",
		"three": "^0.185"
	},
	"devDependencies": {
		"@types/bun": "^1.3",
		"@types/three": "^0.185",
		"biome": "npm:@biomejs/biome@^2.5.6",
		"dprint": "^0.55",
		"runner-run": "^0.24.0",
		"typescript": "^7"
	},
	"packageManager": "bun@1.3.14",
	"trustedDependencies": ["@openrouter/sdk"]
}
