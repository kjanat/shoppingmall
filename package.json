{
	"name": "mall-sim",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*.ts"
	},
	"scripts": {
		"bd": "run build",
		"bench": "node scripts/perf/bench.ts",
		"bench:headless": "MALL_PERF_SOFTWARE=1 node scripts/perf/bench.ts",
		"build": "run -s typecheck check build.ts",
		"build:static": "run -s typecheck check static",
		"dev": "bun --hot server/main.ts",
		"diagnose": "node scripts/perf/diagnose.ts",
		"diagnose:headless": "MALL_PERF_SOFTWARE=1 node scripts/perf/diagnose.ts",
		"favicon": "npx -y --package=vite-svg-to-ico@latest svg-to-ico generate public/favicon.svg --out-dir public",
		"fmt": "run lint --fix; dprint fmt .",
		"lint": "biome check",
		"prepare": "run scripts/install-hooks.ts || true",
		"profile": "node scripts/perf/profile.ts",
		"profile:headless": "MALL_PERF_SOFTWARE=1 node scripts/perf/profile.ts",
		"pull": "git pull --ff-only || echo 'failed to deploy' >&2",
		"redeploy": "run -s pull live",
		"shots": "node scripts/shots.ts",
		"prestart": "run build",
		"start": "NODE_ENV=production dist/mall",
		"static": "run build.ts --static",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"volta:pin": "volta pin node@latest npm@11; node --version > .node-version; run -qq fmt package.json || true"
	},
	"dependencies": {
		"@elevenlabs/elevenlabs-js": "^2.60",
		"@openrouter/sdk": "^1.2",
		"ansispeck": "^0.4",
		"gsap": "^3.15",
		"postprocessing": "^6.39",
		"three": "^0.185"
	},
	"devDependencies": {
		"@types/bun": "^1.3",
		"@types/three": "^0.185",
		"biome": "npm:@biomejs/biome@^2.5.6",
		"dprint": "^0.55",
		"dreamcli": "https://pkg.pr.new/@kjanat/dreamcli@b0467356628bf845111f2716eaf435396fcba65c",
		"playwright": "^1.62.1",
		"runner-run": "^0.24.0",
		"typescript": "^7",
		"zod": "^4.4.3"
	},
	"packageManager": "bun@1.3.14",
	"volta": {
		"node": "26.7.0",
		"npm": "11.19.0"
	},
	"trustedDependencies": ["@openrouter/sdk", "dprint"]
}
