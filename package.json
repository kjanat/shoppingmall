{
	"name": "mall-sim",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"bench": "run scripts/perf/bench.ts",
		"bench:headless": "CHROME_PATH=scripts/perf/chrome-headless.sh run scripts/perf/bench.ts",
		"build": "run -s typecheck check build.ts",
		"build:static": "run -s typecheck check static",
		"check": "run -s check:world check:lights",
		"check:lights": "run scripts/check-lights.ts",
		"check:world": "run scripts/check-world.ts",
		"dev": "bun --hot server/main.ts",
		"diagnose": "run scripts/perf/diagnose.ts",
		"diagnose:headless": "CHROME_PATH=scripts/perf/chrome-headless.sh run scripts/perf/diagnose.ts",
		"favicon": "npx -y --package=vite-svg-to-ico@latest svg-to-ico generate public/favicon.svg --out-dir public",
		"fmt": "run lint --fix; dprint fmt .",
		"lint": "biome check",
		"prepare": "run scripts/install-hooks.ts || true",
		"prestart": "run build",
		"start": "NODE_ENV=production dist/mall",
		"static": "run build.ts --static",
		"typecheck": "tsc --noEmit",
		"volta:pin": "volta pin node@latest npm@11 && node --version > .node-version; run -qq fmt package.json || true"
	},
	"dependencies": {
		"@elevenlabs/elevenlabs-js": "^2.60",
		"@openrouter/sdk": "^1.2",
		"ansispeck": "^0.4",
		"gsap": "^3.15",
		"postprocessing": "^6.39",
		"three": "^0.185"
	},
	"devDependencies": {
		"@types/bun": "^1.3",
		"@types/three": "^0.185",
		"biome": "npm:@biomejs/biome@^2.5.6",
		"dprint": "^0.55",
		"dreamcli": "https://pkg.pr.new/@kjanat/dreamcli@117",
		"runner-run": "^0.24.0",
		"typescript": "^7"
	},
	"packageManager": "bun@1.3.14",
	"volta": {
		"node": "26.6.0",
		"npm": "11.19.0"
	},
	"trustedDependencies": ["@openrouter/sdk"]
}
